{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C++: Build and Run",
            "type": "shell",
            "command": "clang++ -std=c++17 \"${file}\" -o \"${workspaceFolder}/build/${fileBasenameNoExtension}\" && \"${workspaceFolder}/build/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false,
                "showReuseMessage": false,
                "clear": false,
                "close": false
            },
            "problemMatcher": []
        }
    ]
}